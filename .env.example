# The database npm run dev prepares and serves. db:provision:admin reads this
# same value from .env.local, so the platform owner lands in the file the dev
# server actually opens.
DB_FILE_NAME=.data/academy-empty.db
# Required in production. Generate at least 32 cryptographically random characters.
BETTER_AUTH_SECRET=
# Optional. Leave empty. Only `npm run build` and the fixture:start:* commands set it,
# so that a production build serving a disposable local fixture may fall back to the
# committed local-only secret. A real deployment must set BETTER_AUTH_SECRET instead.
SMBA_ALLOW_LOCAL_AUTH_SECRET=
# Optional override for Secure auth cookies. Defaults to on in production; set false
# only for a plain-HTTP local preview. Vercel production always uses secure cookies.
BETTER_AUTH_SECURE_COOKIES=
# Optional prototype flag for Academy-ID-only sign-in. Never true in production;
# a Vercel Production boot refuses to start when it is.
PROTOTYPE_ACADEMY_ID_AUTH=
# Mandatory for the head coach in production. The platform owner always requires it.
SMBA_REQUIRE_COACH_TOTP=true
# Verified recovery email. Enable after adding a verified Resend sender;
# explicit enforcement fails safely unless both Resend settings are present.
SMBA_REQUIRE_RECOVERY_EMAIL=true
RESEND_API_KEY=
SMBA_AUTH_EMAIL_FROM=SMBA Security <security@example.com>
SMBA_AUTH_EMAIL_REPLY_TO=
# Local tests can capture auth mail without making network requests.
SMBA_AUTH_MAIL_TRANSPORT=memory
# Optional accessibility-gate profile. It is the only value that lets the memory mail
# transport survive a production build, and only for a database under the OS temp root.
SMBA_ACCESSIBILITY_PROFILE=
# Operator-only inputs for `npm run db:provision:admin`. Do not keep real values
# in a committed file or production runtime environment.
SMBA_INITIAL_ADMIN_NAME=
SMBA_INITIAL_ADMIN_PASSWORD=
SMBA_INITIAL_ADMIN_PIN=
# Required when `npm run db:migrate` or `npm run db:bootstrap` prepares a Vercel
# Production database already holding a head coach with no credential; that run throws
# without it. `vercel-build` prepares an empty academy, so it never reaches this.
SMBA_BOOTSTRAP_HEAD_COACH_PASSWORD=
# Optional local-only deterministic credentials for academy fixtures.
SMBA_LOCAL_AUTH_PASSWORD=
SMBA_FIXTURE_PASSWORD=
# Injected automatically by the Vercel Turso Marketplace integration.
# Keep these scoped to Vercel's Production environment; a preview deployment that
# holds the academy's credentials migrates the academy's database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set only on a Vercel environment whose remote database is disposable and its own.
# Without it, a non-production deployment skips migration and seeding.
SMBA_ALLOW_REMOTE_DB_MIGRATION=false
# Local development stays file-backed unless this explicit opt-in is enabled.
SMBA_USE_TURSO=false
# Optional in development and tests; production must replace this with the final HTTPS origin.
NEXT_PUBLIC_SMBA_SITE_ORIGIN=http://localhost:3000
# Optional link target for the "SMBA homepage" control on the authentication screens.
# Defaults to "/", this application's own public website. Left commented out on
# purpose: a bare `KEY=` sets the empty string, and lib/config.ts reads it with
# `?? "/"`, which falls back for undefined but not for "". Copying this file with
# the key present and empty would point 32 brand links at "".
# NEXT_PUBLIC_SMBA_PUBLIC_SITE_URL=https://smbaacademy.in
# Read but never set by hand: NODE_ENV comes from the Next.js command, VERCEL and
# VERCEL_ENV from the platform, and TMPDIR from the operating system. Setting any of
# them here misreports the environment to the auth, mail and database guards.
