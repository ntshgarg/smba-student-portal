PROTOTYPE_ACADEMY_ID_AUTH=false
DB_FILE_NAME=.data/smba.db
# Injected automatically by the Vercel Turso Marketplace integration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development stays file-backed unless this explicit opt-in is enabled.
SMBA_USE_TURSO=false
# Optional in development and tests; production must replace this with the final HTTPS origin.
NEXT_PUBLIC_SMBA_SITE_ORIGIN=http://localhost:3000
