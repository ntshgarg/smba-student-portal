DB_FILE_NAME=.data/smba.db
# Required in production. Generate at least 32 cryptographically random characters.
BETTER_AUTH_SECRET=
# Mandatory for the head coach in production. The platform owner always requires it.
SMBA_REQUIRE_COACH_TOTP=true
# Verified recovery email. Enable after adding a verified Resend sender;
# explicit enforcement fails safely unless both Resend settings are present.
SMBA_REQUIRE_RECOVERY_EMAIL=true
RESEND_API_KEY=
SMBA_AUTH_EMAIL_FROM=SMBA Security <security@example.com>
SMBA_AUTH_EMAIL_REPLY_TO=
# Local tests can capture auth mail without making network requests.
SMBA_AUTH_MAIL_TRANSPORT=memory
# Operator-only inputs for `npm run db:provision:admin`. Do not keep real values
# in a committed file or production runtime environment.
SMBA_INITIAL_ADMIN_NAME=
SMBA_INITIAL_ADMIN_PASSWORD=
SMBA_INITIAL_ADMIN_PIN=
# Optional local-only deterministic credentials for academy fixtures.
SMBA_LOCAL_AUTH_PASSWORD=
SMBA_FIXTURE_PASSWORD=
# Injected automatically by the Vercel Turso Marketplace integration.
# Keep these scoped to Vercel's Production environment; a preview deployment that
# holds the academy's credentials migrates the academy's database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set only on a Vercel environment whose remote database is disposable and its own.
# Without it, a non-production deployment skips migration and seeding.
SMBA_ALLOW_REMOTE_DB_MIGRATION=false
# Local development stays file-backed unless this explicit opt-in is enabled.
SMBA_USE_TURSO=false
# Optional in development and tests; production must replace this with the final HTTPS origin.
NEXT_PUBLIC_SMBA_SITE_ORIGIN=http://localhost:3000
