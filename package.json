{
  "name": "smba-player-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DB_FILE_NAME=.data/academy-clean.db next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "fixture:build:clean": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts build-clean",
    "fixture:build:demo": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts build --profile demo",
    "fixture:build:edge": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts build --profile edge",
    "fixture:build:stress": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts build --profile stress",
    "fixture:build:all": "npm run fixture:build:clean && npm run fixture:build:demo && npm run fixture:build:edge && npm run fixture:build:stress",
    "fixture:verify:clean": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts verify --target .data/academy-clean.db",
    "fixture:verify:demo": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts verify --profile demo",
    "fixture:verify:edge": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts verify --profile edge",
    "fixture:verify:stress": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts verify --profile stress",
    "fixture:verify:all": "npm run fixture:verify:clean && npm run fixture:verify:demo && npm run fixture:verify:edge && npm run fixture:verify:stress",
    "fixture:start:demo": "DB_FILE_NAME=.data/academy-demo.db next start -p 3000",
    "fixture:start:edge": "DB_FILE_NAME=.data/academy-edgecases.db next start -p 3000",
    "fixture:start:stress": "DB_FILE_NAME=.data/academy-stress.db next start -p 3000",
    "regression:fixture": "NODE_PATH=./node_modules/next/dist/compiled NODE_OPTIONS=--conditions=react-server tsx scripts/regression/fixture.ts",
    "regression:prepare": "npm run regression:fixture -- prepare",
    "regression:seed": "npm run regression:fixture -- seed --stage loaded",
    "regression:verify": "npm run regression:fixture -- verify",
    "regression:test": "vitest run tests/regression-fixture.test.ts",
    "regression:registration": "playwright test -c tests/e2e/playwright.registration-resilience.config.ts",
    "regression:capture": "playwright test -c tests/e2e/playwright.config.ts",
    "regression:start": "npm run fixture:start:stress"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "pdfkit": "^0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.19",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  }
}
